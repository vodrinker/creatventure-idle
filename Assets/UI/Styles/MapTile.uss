/* Zastąp swój obecny styl .map-tile tym: */
.map-tile {
    /* Mówi kafelkowi (AspectRatioBox), aby zajął 100%
       szerokości swojego rodzica (TemplateContainer) */
    width: 100%;
    
    /* Niezbędne, aby .map-tile__icon mógł się pozycjonować */
    position: relative;

    /* (Te style przeniesiemy do MapRow.uss, gdzie będą sterować
     * kontenerem, który trzyma ten kafelek)
     */
}

.map-tile--owned {
    border-width: 2px;
    border-color: #44CC44;
}

/* Ten styl jest POPRAWNY i zostaje bez zmian */
.map-tile__icon {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 10px;
}

.map-tile-hp-bar {
    position: absolute;
    left: 10%;
    width: 80%;
    height: 4px; /* Reduced from 6px */
    background-color: rgba(30, 30, 30, 0.8);
    border-radius: 2px;
    display: none; /* Initially hidden */
}

.map-tile-hp-bar__fill {
    height: 100%;
    border-radius: 2px;
}

.map-tile-hp-bar--enemy {
    bottom: 11px; /* Moved to bottom, just above player bar */
}

.map-tile-hp-bar--player {
    bottom: 5px;
}

.hp-fill--enemy {
    background-color: #CC4444; 
}

.hp-fill--player {
    background-color: #44CC44;
}