.popup-content {
    background-color: rgb(51, 51, 51);
    padding: 15px;
    border-radius: 10px;
    align-items: center;
    width: 280px;
}

.popup-image {
    width: 120px;
    height: 120px;
    background-color: rgb(85, 85, 85);
    margin-bottom: 10px;
}

.popup-title {
    -unity-text-align: middle-center;
    font-size: 20px;
    color: white;
    white-space: normal;
    margin-bottom: 10px;
}

.buy-button {
    margin-top: 10px;
    height: 35px;
    width: 120px;
}

/* --- Styles migrated from CreaturesView.uss (Original) --- */

.node-production-section {
    margin-top: 10px;
    padding: 8px;
    background-color: rgba(40, 40, 50, 0.6);
    border-radius: 6px;
    width: 100%;
}

.production-item-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
}

.production-item-name {
    flex-grow: 1;
    font-size: 14px;
    color: #DDDDDD;
}

.production-rate {
    font-size: 12px;
    color: #AAAAAA;
    margin-left: 10px;
}

.progress-bar-container {
    width: 100px;
    height: 12px;
    background-color: #3D3215;
    border-radius: 4px;
    overflow: hidden;
    margin-left: 10px;
    flex-shrink: 0;
}

.progress-bar-fill {
    height: 100%;
    min-height: 100%;
    background-color: #FFD700;
    border-radius: 4px;
}

.node-creature-section {
    margin-top: 10px;
    padding: 8px;
    background-color: rgba(40, 40, 50, 0.6);
    border-radius: 6px;
    flex-direction: row;
    align-items: center;
}

.assigned-creature-icon {
    width: 48px;
    height: 48px;
    margin-right: 10px;
    background-color: rgba(60, 60, 80, 0.8);
    border-radius: 6px;
    border-width: 1px;
    border-color: #FFD700;
}

.assigned-creature-name {
    flex-grow: 1;
    font-size: 14px;
    color: #FFFFFF;
}

.remove-creature-button {
    padding: 5px 10px;
    background-color: #AA3333;
    color: #FFFFFF;
    border-radius: 4px;
}

.remove-creature-button:hover {
    background-color: #CC4444;
}

.assign-creature-button {
    padding: 8px 15px;
    background-color: #3D6B3D;
    color: #FFFFFF;
    border-radius: 4px;
    margin-top: 10px;
    width: 100%;
}

.assign-creature-button:hover {
    background-color: #4D8B4D;
}

.possible-creatures-section {
    margin-top: 10px;
    padding: 8px;
    background-color: rgba(40, 40, 50, 0.6);
    border-radius: 6px;
}

.section-label {
    font-size: 12px;
    color: #888888;
    margin-bottom: 5px;
}

.possible-creature-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
}

.possible-creature-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
}

.possible-creature-name {
    font-size: 12px;
    color: #CCCCCC;
}

.tab-bar {
    flex-direction: row;
    margin: 10px 0;
    padding: 0 5px;
    width: 100%;
}

.tab-button {
    flex-grow: 1;
    padding: 8px 15px;
    margin: 0 2px;
    background-color: rgba(60, 60, 80, 0.6);
    color: #888888;
    border-radius: 6px 6px 0 0;
    border-width: 0;
}

.tab-button:hover {
    background-color: rgba(80, 80, 100, 0.8);
    color: #AAAAAA;
}

.tab-active {
    background-color: rgba(80, 80, 110, 0.9);
    color: #FFD700;
    border-bottom-width: 2px;
    border-bottom-color: #FFD700;
}

.tab-content {
    flex-grow: 1;
    padding: 10px;
    background-color: rgba(40, 40, 50, 0.6);
    border-radius: 0 0 6px 6px;
    width: 100%;
}

.battle-section {
    padding: 10px;
    margin: 5px 0;
    border-radius: 8px;
    align-items: center;
    width: 100%;
}

.enemy-section {
    background-color: rgba(120, 50, 50, 0.4);
    border-width: 1px;
    border-color: rgba(180, 80, 80, 0.5);
    border-left-width: 3px;
    border-left-color: #FF4444; 
}

.player-section {
    background-color: rgba(50, 100, 50, 0.4);
    border-width: 1px;
    border-color: rgba(80, 150, 80, 0.5);
    border-left-width: 3px;
    border-left-color: #44FF44;
}

.enemy-label { color: #CC6666; }
.player-label { color: #66CC66; }

.creature-battle-info {
    font-size: 16px;
    -unity-font-style: bold;
    margin: 5px 0;
}

.enemy-info { color: #FFAAAA; }
.player-info { color: #AAFFAA; }

.creature-hp {
    font-size: 14px;
    margin-bottom: 8px;
}

.enemy-hp { color: #FF8888; }
.player-hp { color: #88FF88; }

.battle-creature-image {
    width: 80px;
    height: 80px;
    background-color: rgba(30, 30, 40, 0.8);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 215, 0, 0.5);
}

.hp-bar-container {
    width: 120px;
    height: 10px;
    background-color: rgba(30, 30, 30, 0.8);
    border-radius: 5px;
    overflow: hidden;
    margin: 5px 0;
    flex-shrink: 0;
}

.battle-hp-fill {
    height: 100%;
    border-radius: 5px;
    /* transition: width 0.2s; */
}

.enemy-hp-bar { background-color: #CC4444; }
.player-hp-bar { background-color: #44CC44; }

.progress-section {
    margin-top: 10px;
    padding: 10px;
    background-color: rgba(40, 40, 50, 0.6);
    border-radius: 6px;
    align-items: center;
    width: 100%;
}

.progress-label {
    font-size: 14px;
    color: #FFD700;
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.level-controls {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.level-button {
    width: 30px;
    height: 30px;
    font-size: 18px;
    -unity-font-style: bold;
    background-color: rgba(60, 60, 80, 0.8);
    color: #FFFFFF;
    border-radius: 4px;
    border-width: 0;
    margin: 0 10px;
}

.level-button:hover {
    background-color: rgba(80, 80, 100, 0.9);
}

.level-button:disabled {
    background-color: rgba(40, 40, 40, 0.5);
    color: #666666;
}

.level-display {
    font-size: 16px;
    color: #FFFFFF;
    -unity-font-style: bold;
    margin: 0 5px;
}