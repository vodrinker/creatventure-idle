/* Global Styles for Consistency */

.menu-btn {
    height: 40px;
    background-color: rgb(34, 34, 34);
    border-width: 1px;
    border-color: #444;
    border-radius: 8px; /* Matching the previous look */
    color: white;
    font-size: 12px;
    margin: 2px;
    padding: 0; /* consistent padding */
}

.menu-btn.selected {
    background-color: rgb(45, 45, 45);
    border-color: rgb(0, 122, 255); /* Active Blue Border */
}

/* Compact version for toolbars if needed, or reuse menu-btn with override */
.menu-btn-compact {
    height: 35px;
    border-radius: 4px;
}
