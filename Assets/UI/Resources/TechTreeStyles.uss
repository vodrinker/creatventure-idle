
.tech-node {
    position: absolute;
    width: 40px;
    height: 40px;
    background-color: #444;
    border-width: 2px;
    border-color: #222;
    border-radius: 4px;
    justify-content: center;
    align-items: center;
}

.tech-node-unlocked {
    background-color: #2a8;
    border-color: #4fa;
}

.tech-node-maxed {
    background-color: #fd0;
    border-color: #fe5;
}

.tech-node-available {
    border-color: #fff;
}

.tech-node-locked {
    opacity: 0.7;
    background-color: #2f2f2fff;
}

.tech-node-label {
    position: absolute;
    bottom: -20px;
    color: white;
    font-size: 10px;
    width: 100px;
    -unity-text-align: middle-center;
    white-space: normal;
}


