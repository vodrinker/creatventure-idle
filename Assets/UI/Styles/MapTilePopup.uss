.popup-content {
    background-color: rgb(51, 51, 51);
    padding: 20px;
    border-radius: 10px;
    align-items: center;
    width: 350px;
}

.popup-image {
    width: 200px;
    height: 200px;
    background-color: rgb(85, 85, 85);
    margin-bottom: 10px;
}

.popup-title {
    -unity-text-align: middle-center;
    font-size: 24px;
    color: white;
    white-space: normal;
    margin-bottom: 15px;
}

.buy-button {
    margin-top: 15px;
    height: 40px;
    width: 150px;
    background-color: #4CAF50;
    color: white;
    -unity-font-style: bold;
    border-radius: 5px;
}

/* Tab System */
.tab-bar {
    flex-direction: row;
    width: 100%;
    justify-content: space-around;
    margin-top: 15px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.2);
    padding-top: 10px;
}

/* Explicitly style the tab buttons to look like buttons */
.tab-button {
    flex-grow: 1;
    margin: 0 5px;
    height: 35px;
    background-color: #444;
    color: #AAA;
    border-width: 1px;
    border-color: #666;
    border-radius: 5px;
}

.tab-button.tab-active {
    background-color: #666;
    color: #FFD700;
    border-color: #FFD700;
}

.tab-content {
    width: 100%;
    align-items: center;
}

/* Battle Section */
.battle-section {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 5px;
    padding: 5px;
    margin-bottom: 5px;
}

.enemy-section { border-left-width: 3px; border-left-color: #FF4444; }
.player-section { border-left-width: 3px; border-left-color: #44FF44; }

.section-label {
    color: #DDD;
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.creature-battle-info {
    color: white;
    font-size: 14px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.creature-hp {
    color: #AAA;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.hp-bar-container {
    height: 6px;
    width: 80%;
    background-color: #222;
    margin-top: 2px;
    align-self: center;
    border-radius: 3px;
    overflow: hidden;
}

.battle-hp-fill {
    height: 100%;
    background-color: #4CAF50;
}
.enemy-hp-bar { background-color: #FF4444; }

.battle-creature-image {
    width: 64px;
    height: 64px;
    align-self: center;
    margin-top: 5px;
}

/* Production */
.node-production-section {
    width: 100%;
}
.production-item-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 2px 0;
}
.production-item-name { color: white; width: 40%; }
.production-rate { color: #FFD700; width: 30%; -unity-text-align: middle-right; }
.progress-bar-container { width: 30%; height: 5px; background-color: #333; }
.progress-bar-fill { height: 100%; background-color: #4CAF50; }

/* Progress Controls */
.progress-section {
    margin-top: 10px;
    align-items: center;
    width: 100%;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
    padding-top: 5px;
}
.progress-label { color: #AAA; font-size: 12px; }
.level-controls { flex-direction: row; align-items: center; margin-top: 5px; }
.level-button { width: 30px; height: 30px; }
.level-display { width: 60px; -unity-text-align: middle-center; color: white; font-size: 14px; }