.creatures-view-root {
    flex-grow: 1;
    padding: 6px;
    background-color: rgba(30, 30, 40, 0.95);
}

.view-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
}

.view-title {
    font-size: 18px;
    color: #FFFFFF;
    -unity-font-style: bold;
}

.traps-label {
    font-size: 16px;
    color: #FFAA00; /* Orange-ish for Traps */
    -unity-font-style: bold;
}

.tab-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}

/* Tab buttons use .menu-btn from GlobalStyles, but we can override specific margins */
.tab-container .menu-btn {
    width: 45%;
    margin: 0 4px;
}

.creatures-scroll-view {
    flex-grow: 1;
}

.creatures-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
}

/* Collection List Item Styles (Restored & Fixed) */
.creature-list-item {
    flex-direction: row;
    align-items: center;
    padding: 8px 15px;
    margin: 2px 0;
    background-color: rgba(60, 60, 80, 0.8);
    border-radius: 4px;
    width: 100%;
}

.creature-list-item:hover {
    background-color: rgba(80, 80, 110, 0.9);
}

.creature-icon {
    width: 40px;
    height: 40px;
    margin-right: 15px;
    background-color: rgba(40, 40, 50, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: #666;
}

.creature-info {
    flex-grow: 1;
    flex-direction: row; /* Horizontal layout */
    align-items: center;
    justify-content: space-between; /* Name left/center, Level right */
}

.creature-name {
    font-size: 16px;
    color: #FFFFFF;
    -unity-font-style: bold;
    flex-grow: 1;
    -unity-text-align: middle-center; /* Center name as requested */
}

.creature-level {
    font-size: 14px;
    color: #DDDDDD;
    min-width: 60px;
    -unity-text-align: middle-right; /* Right align level */
}

/* Wild Table Styles */
.wild-container {
    flex-grow: 1;
    margin-top: 5px;
}

.wild-table-header {
    flex-direction: row;
    background-color: rgba(50, 50, 70, 0.9);
    padding: 8px 2px;
    border-bottom-width: 2px;
    border-bottom-color: #FFAA00;
}

.header-cell {
    color: #FFAA00;
    -unity-font-style: bold;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.col-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    padding-left: 5px;
}

.col-level {
    width: 60px;
}

.col-catch {
    width: 80px;
}

.wild-list {
    flex-grow: 1;
}

.wild-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 2px;
    background-color: rgba(40, 40, 55, 0.7);
    border-bottom-width: 1px;
    border-bottom-color: rgba(100, 100, 120, 0.5);
    height: 40px;
}

.wild-row:hover {
    background-color: rgba(60, 60, 80, 0.8);
}

.row-name {
    flex-grow: 1;
    color: #FFFFFF;
    font-size: 14px;
    -unity-text-align: middle-left;
    padding-left: 5px;
}

.row-level {
    width: 60px;
    color: #AAAAAA;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.catch-btn {
    width: 70px;
    height: 28px;
    background-color: rgba(50, 150, 50, 0.8);
    color: #FFFFFF;
    border-radius: 4px;
    border-width: 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.catch-btn:hover {
    background-color: rgba(70, 180, 70, 0.9);
}

.catch-btn:disabled {
    background-color: rgba(50, 50, 50, 0.5);
    color: #888888;
}

/* Picker Popup Styles */
.creature-picker-popup {
    background-color: rgba(30, 30, 40, 0.98);
    border-color: #444;
    border-width: 1px;
    width: 300px;
    max-height: 400px;
    padding: 10px;
    border-radius: 8px;
} 
/* Reusing list item styles for picker */
